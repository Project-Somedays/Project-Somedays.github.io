{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "previewPath": null,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Content preview",
          "name": "preview",
          "type": "image"
        },
        {
          "title": "Is in draft",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Categories",
          "name": "categories",
          "type": "categories"
        }
      ]
    },

    {
    "name": "Blender Challenge",
    "template": "blender-challenge.md",
    "fields": [
      {
        "title": "Title",
        "name": "title",
        "type": "string"
      },
      {
        "title": "Draft Status",
        "name": "draft",
        "type": "draft"
      },
      {
        "title": "Header Teaser Thumbnail",
        "name": "header.teaser",
        "type": "image"
      },
      {
        "title": "Header Banner Image",
        "name": "header.image",
        "type": "image"
      },
      {
        "title": "Social Preview Image",
        "name": "preview",
        "type": "image"
      },
      {
        "title": "Tags",
        "name": "tags",
        "type": "tags"
      },
      {
        "title": "Keywords",
        "name": "keywords",
        "type": "categories"
      },
      {
        "title": "Table of Contents",
        "name": "toc",
        "type": "boolean",
        "hidden": true
      },
      {
        "title": "Last Modified",
        "name": "last_modified_at",
        "type": "datetime",
        "isModifiedDate": true
      }
    ]
  }
  ],
  "frontMatter.framework.id": "jekyll",
  "frontMatter.content.publicFolder": "assets",
  "frontMatter.preview.host": "http://localhost:4000",
  "frontMatter.content.pageFolders": [
    {
      "title": "drafts",
      "path": "[[workspace]]/_drafts"
    },
    {
      "title": "posts",
      "path": "[[workspace]]/_posts"
    }
  
  ],
  "frontMatter.git.enabled": true
}